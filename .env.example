# Copy to .env.local. Server-only credentials: never use a VITE_ prefix for routing keys.
# Enable Google Maps Routes API and billing for this key. Restart Vite after changes.
GOOGLE_MAPS_API_KEY=
# Optional separate key for Places API (New); defaults to GOOGLE_MAPS_API_KEY.
GOOGLE_PLACES_API_KEY=
MTA_GTFS_CATALOG=data/mta-subway.json

# Separate Gemini key from Google AI Studio. Used only by the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Active provider: groq or gemini. Keys stay on the server.
AI_PROVIDER=groq
# Groq speech and agent models.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_AGENT_MODEL=openai/gpt-oss-120b
