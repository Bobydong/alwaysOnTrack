{
  "name": "evenhub-asr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "powershell -ExecutionPolicy Bypass -File scripts/phone-localhost.ps1",
    "gtfs:import": "node scripts/import-mta-gtfs.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist",
    "simulate": "evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
